	cd /home/liam/friotaioch/build_win && $(MAKE) $(MAKESILENT) -f src/qt/test/CMakeFiles/test_bitcoin-qt.dir/build.make src/qt/test/CMakeFiles/test_bitcoin-qt.dir/wallettests.cpp.i
.PHONY : wallettests.cpp.i

wallettests.s: wallettests.cpp.s
.PHONY : wallettests.s

# target to generate assembly for a file
wallettests.cpp.s:
	cd /home/liam/friotaioch/build_win && $(MAKE) $(MAKESILENT) -f src/qt/test/CMakeFiles/test_bitcoin-qt.dir/build.make src/qt/test/CMakeFiles/test_bitcoin-qt.dir/wallettests.cpp.s
.PHONY : wallettests.cpp.s

