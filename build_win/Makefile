.PHONY : dummy_cxx_source.obj

# target to build an object file
dummy_cxx_source.cpp.obj:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/check_loose_linked_libraries.dir/build.make CMakeFiles/check_loose_linked_libraries.dir/dummy_cxx_source.cpp.obj
.PHONY : dummy_cxx_source.cpp.obj

dummy_cxx_source.i: dummy_cxx_source.cpp.i
.PHONY : dummy_cxx_source.i

# target to preprocess a source file
dummy_cxx_source.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/check_loose_linked_libraries.dir/build.make CMakeFiles/check_loose_linked_libraries.dir/dummy_cxx_source.cpp.i
.PHONY : dummy_cxx_source.cpp.i

dummy_cxx_source.s: dummy_cxx_source.cpp.s
.PHONY : dummy_cxx_source.s

# target to generate assembly for a file
dummy_cxx_source.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/check_loose_linked_libraries.dir/build.make CMakeFiles/check_loose_linked_libraries.dir/dummy_cxx_source.cpp.s
.PHONY : dummy_cxx_source.cpp.s

